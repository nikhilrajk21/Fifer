# Safe backend template; never put real credentials here.
# The text adapter lazily reads GEMINI_API_KEY from backend/.env only after authorization.
# Mock voice never reads this file or a key. Do not enable real calls.
GEMINI_API_KEY=
# A key alone never enables a call. Runtime activation uses two one-process
# environment variables, not entries loaded from this file. See README.md.
# Voice model/limits are fixed server-side in live_voice.py and voice.py in V2.
# VOICE_MAX_SESSION_SECONDS=300 belongs in backend/.env if a future approved
# configuration loader supports it; V2 enforces 300 without reading this setting.
